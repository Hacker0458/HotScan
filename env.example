# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hotscan?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OpenAI
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxx"

# Email (for NextAuth Email Provider)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="user@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="noreply@hotscan.app"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Error Tracking
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxxx@sentry.io/xxxxx"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Cron Secret (for protecting cron endpoints)
CRON_SECRET="your-cron-secret-here"

# Data APIs (Optional)
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"
COINGECKO_API_KEY="your-coingecko-key"

# Vercel (Auto-populated in production)
# VERCEL_URL
# VERCEL_ENV
