# ===================================
# Database
# ===================================
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# ===================================
# NextAuth (if needed in future)
# ===================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ===================================
# OpenAI API
# ===================================
OPENAI_API_KEY="your-openai-api-key"
OPENAI_API_BASE="https://api.openai.com/v1"

# ===================================
# Data Source
# ===================================
DATASOURCE="dexscreener"
DEXSCREENER_BASE="https://api.dexscreener.com/latest"

# Asset pool expansion queries (comma-separated)
HOTSCAN_QUERIES="DOGE,PEPE,SHIB,BONK,WIF,POPCAT,MEW,BRETT,TURBO,ANDY"

# ===================================
# Application Settings
# ===================================
# Homepage refresh interval in milliseconds (default: 30000 = 30 seconds)
NEXT_PUBLIC_HOMEPAGE_REFRESH_INTERVAL_MS=30000

# Default signal window (5m or 1h)
NEXT_PUBLIC_SIGNAL_WINDOW_DEFAULT=1h

# Minimum liquidity filter in USD (default: 100000 = $100K)
MIN_LIQ_FILTER_USD=100000

# ===================================
# Jobs & Automation
# ===================================
# Secret token for job API endpoint (/api/jobs/run)
JOB_TOKEN="your-secure-random-token-here"

# ===================================
# AI & RAG
# ===================================
# Mock AI responses for development/testing
MOCK_AI=false

# ===================================
# SEO
# ===================================
# Allow search engine indexing
NEXT_PUBLIC_SEO_ENABLED=true

# ===================================
# Analytics (Optional)
# ===================================
# PostHog project key (if using analytics)
# NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
