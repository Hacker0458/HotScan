// Prisma Schema for HotScan v2 - Financial Asset Analysis Platform
// 资产热点分析平台数据模型

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// Authentication Models (NextAuth)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  
  accounts      Account[]
  sessions      Session[]
  
  // User preferences
  watchlist     String[]  // Asset IDs in watchlist
  preferences   Json?     // {notifications: boolean, theme: string}
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Core Asset Models
// ============================================

model Asset {
  id          String   @id @default(cuid())
  
  // Basic info
  symbol      String   @unique // e.g., "AAPL", "BTC"
  name        String   // e.g., "Apple Inc.", "Bitcoin"
  type        String   // stock, crypto, commodity, forex
  exchange    String?  // NASDAQ, NYSE, Binance, etc.
  
  // Current data
  price       Float?
  change24h   Float?   // Percentage change in 24h
  volume24h   Float?
  marketCap   Float?
  
  // Metadata
  description String?  @db.Text
  logo        String?  // URL to logo image
  tags        String[] // ["tech", "ai", "large-cap"]
  
  // Signals and analysis
  signals     Signal[]
  terms       AssetTerm[]
  
  // Stats
  viewCount   Int      @default(0)
  shareCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([symbol])
  @@index([type])
  @@index([viewCount])
}

// ============================================
// Signal Models (AI-generated insights)
// ============================================

model Signal {
  id        String   @id @default(cuid())
  assetId   String
  
  // Signal data
  type      String   // hot, trending, alert, analysis
  title     String
  content   String   @db.Text
  summary   String?  @db.Text
  
  // AI analysis
  sentiment String   // bullish, bearish, neutral
  confidence Float   // 0-1
  impact    String   // high, medium, low
  
  // Key points
  keyPoints String[] // Bullet points
  entities  Json?    // Extracted entities
  
  // Sources
  sources   Json[]   // [{url, title, publishedAt}]
  
  // Metadata
  viewCount Int      @default(0)
  featured  Boolean  @default(false)
  
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([assetId])
  @@index([type])
  @@index([sentiment])
  @@index([createdAt])
  @@index([featured])
}

// ============================================
// Learning / RAG Models
// ============================================

model Term {
  id          String   @id @default(cuid())
  
  // Term data
  term        String   @unique // e.g., "P/E Ratio", "Market Cap"
  category    String   // fundamental, technical, crypto, general
  definition  String   @db.Text
  example     String?  @db.Text
  
  // RAG embeddings
  embedding   Unsupported("vector(1536)")?
  
  // Relations
  relatedTerms String[] // IDs of related terms
  assets      AssetTerm[]
  
  // Metadata
  searchCount Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([term])
  @@index([category])
}

// Link table for Asset <-> Term
model AssetTerm {
  id       String @id @default(cuid())
  assetId  String
  termId   String
  
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  
  @@unique([assetId, termId])
  @@index([assetId])
  @@index([termId])
}

// ============================================
// Share / Poster Models
// ============================================

model Share {
  id          String   @id @default(cuid())
  
  // Content
  assetId     String
  signalId    String?
  
  // Poster data
  title       String
  description String?
  imageUrl    String?  // Generated poster image URL
  
  // Analytics
  viewCount   Int      @default(0)
  
  createdAt   DateTime @default(now())
  
  @@index([assetId])
  @@index([viewCount])
}

// ============================================
// Job & Analytics Models
// ============================================

model JobRun {
  id           String   @id @default(cuid())
  jobName      String   // fetch-tickers, make-signals, embed-terms
  status       String   // pending, running, success, failed
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  duration     Int?     // milliseconds
  
  // Results
  processed    Int      @default(0)
  succeeded    Int      @default(0)
  failed       Int      @default(0)
  errorMessage String?  @db.Text
  metadata     Json?
  
  @@index([jobName])
  @@index([status])
  @@index([startedAt])
}

model Analytics {
  id        String   @id @default(cuid())
  date      DateTime @default(now()) @db.Date
  
  // Metrics
  pageViews Int      @default(0)
  users     Int      @default(0)
  searches  Int      @default(0)
  shares    Int      @default(0)
  
  // Top items (JSON arrays of {id, count})
  topAssets Json?
  topTerms  Json?
  
  @@unique([date])
  @@index([date])
}
